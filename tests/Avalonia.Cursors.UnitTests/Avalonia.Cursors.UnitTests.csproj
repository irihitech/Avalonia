<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <PropertyGroup>
    <TargetFramework>$(AvsCurrentTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <Import Project="..\..\build\UnitTests.NetCore.targets" />
  <Import Project="..\..\build\XUnit.props" />
  <Import Project="..\..\build\SharedVersion.props" />
  <Import Project="..\..\build\NullableEnable.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\src\Windows\Avalonia.Win32\Avalonia.Win32.csproj" />
    <ProjectReference Include="..\..\src\Avalonia.X11\Avalonia.X11.csproj" />
    <ProjectReference Include="..\..\src\Avalonia.Wayland\Avalonia.Wayland.csproj" />
    <!-- Same mapping sources the backends compile, linked here because a plain
         net test project cannot reference the net-android/net-browser/WinUI assemblies. -->
    <Compile Include="..\..\src\Android\Avalonia.Android\StandardCursorTypePointerIcons.cs" Link="Android\StandardCursorTypePointerIcons.cs" />
    <Compile Include="..\..\src\Browser\Avalonia.Browser\StandardCursorTypeCssKeywords.cs" Link="Browser\StandardCursorTypeCssKeywords.cs" />
    <Compile Include="..\..\src\Windows\Avalonia.WinUI\StandardCursorTypeCursorShapes.cs" Link="WinUI\StandardCursorTypeCursorShapes.cs" />
  </ItemGroup>
</Project>
